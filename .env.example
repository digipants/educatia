# Public site URL for SEO metadata, sitemap, and canonical tags
NEXT_PUBLIC_SITE_URL=https://educatiawelfaretrust.org

# SMTP configuration for form submissions
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=educatiawelfaretrust@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=educatiawelfaretrust@gmail.com

# Application storage is opt-in and server-only. Keep false until storage is approved.
APPLICATION_STORAGE_ENABLED=false
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/educatia?retryWrites=true&w=majority

# Read-only admin inbox is separately gated. Keep disabled until privacy and operational approval.
ADMIN_APPLICATIONS_ENABLED=false
ADMIN_EMAILS=admin@example.org

# Google OAuth for the admin inbox (server-only; create credentials in Google Cloud Console).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
