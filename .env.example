# Public site URL for SEO metadata, sitemap, and canonical tags
NEXT_PUBLIC_SITE_URL=https://educatiawelfaretrust.org

# SMTP configuration for form submissions
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=educatiawelfaretrust@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=educatiawelfaretrust@gmail.com

# Application storage is opt-in and server-only. Keep false until storage is approved.
APPLICATION_STORAGE_ENABLED=false
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/educatia?retryWrites=true&w=majority

# Read-only admin inbox is separately gated. Keep disabled until privacy and operational approval.
ADMIN_APPLICATIONS_ENABLED=false
ADMIN_EMAILS=admin@example.org

# Google OAuth for the admin inbox (server-only; create credentials in Google Cloud Console).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CMS is independent of applicant/admin storage. All switches remain off until
# editorial access and publishing responsibilities are explicitly configured.
CMS_CONTENT_ENABLED=false
CMS_PUBLISHING_ENABLED=false
CMS_EDITOR_EMAILS=editor@example.org
CMS_PUBLISHER_EMAILS=publisher@example.org

# Private photo storage is separately gated. Netlify Blobs uses the site's
# server-side runtime context; preview deployments use deploy-scoped storage.
CMS_MEDIA_ENABLED=false
# Gallery publishing is independent from the News/Program CMS publishing gate.
CMS_MEDIA_PUBLISHING_ENABLED=false
# Choose only after privacy/jurisdiction approval; blank disables media storage.
CMS_MEDIA_STORAGE_REGION=
# Identifiable-minor publication requires an independently approved process;
# a checkbox is not proof of guardian consent. Keep this disabled.
CMS_MINOR_MEDIA_PUBLISHING_ENABLED=false
