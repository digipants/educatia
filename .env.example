# Public site URL for SEO metadata, sitemap, and canonical tags
NEXT_PUBLIC_SITE_URL=https://educatiawelfaretrust.org

# SMTP configuration for form submissions
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=educatiawelfaretrust@gmail.com
SMTP_PASS=your_gmail_app_password
